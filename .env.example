# ==============================================================================
# The Lenny Growth Assistant — Environment Configuration (.env)
# ==============================================================================

# Application Mode
DEBUG=false
VERSION=1.0.0

# Database Configuration (Defaults to local SQLite if Postgres is omitted)
# For local evaluation without Docker: sqlite+aiosqlite:///./lenny_growth.db
# For Docker Compose: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lenny_growth
DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db

# Mandatory Demo Provider: Local Ollama
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional Cloud Providers (Can be toggled via in-app UI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Knowledge Retrieval Hyperparameters
MAX_RETRIEVAL_CHUNKS=4
SIMILARITY_THRESHOLD=0.15
CHUNK_SIZE=450
CHUNK_OVERLAP=50
