# ==============================================================================
# Lenny Growth Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
DEBUG=false                          # Set to true for verbose SQL + request logs
VERSION=1.0.0

# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED. SQLite works out-of-the-box for local evaluation (no setup needed).
# Switch to Postgres for production/Docker Compose (pgvector required).
DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lenny_growth

# ── LLM Providers ─────────────────────────────────────────────────────────────
# DEFAULT_PROVIDER controls which provider is active on startup.
# Options: ollama | anthropic | openai | mock
# 'mock' returns deterministic canned responses — no LLM required (useful for CI).
DEFAULT_PROVIDER=ollama

# ── Ollama (Local) — REQUIRED for local demo ──────────────────────────────────
# Install Ollama: https://ollama.com/download
# Pull model:     ollama pull llama3.1:8b
# Start server:   ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Anthropic Claude — OPTIONAL ───────────────────────────────────────────────
# Leave blank to disable. Activates when DEFAULT_PROVIDER=anthropic or toggled in UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── OpenAI — OPTIONAL ─────────────────────────────────────────────────────────
# Leave blank to disable. Activates when DEFAULT_PROVIDER=openai or toggled in UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── RAG Retrieval Hyperparameters ─────────────────────────────────────────────
# MAX_RETRIEVAL_CHUNKS: how many transcript passages to inject per prompt.
# Keep at 1 for fastest local (Ollama) responses; raise to 4 for richer answers.
MAX_RETRIEVAL_CHUNKS=1
SIMILARITY_THRESHOLD=0.15
CHUNK_SIZE=450
CHUNK_OVERLAP=50

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
